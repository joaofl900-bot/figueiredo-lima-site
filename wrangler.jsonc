// Publicação na Cloudflare: o Worker "figueiredo-lima" entrega a pasta dist/ (gerada pelo Astro).
// O pequeno script em worker/index.js roda antes de cada acesso só para levar www e http ao endereço oficial.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "figueiredo-lima",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "figueiredolima.adv.br", "custom_domain": true },
    { "pattern": "www.figueiredolima.adv.br", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
