---
// Página de contato. Sem mapa e sem endereço completo (decisão de 22/10/2026).
import Base from '../layouts/Base.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { escritorio } from '../data/escritorio';

const jsonld = [{ '@type': 'ContactPage', url: `${escritorio.site}/contato/`, about: { '@id': `${escritorio.site}/#escritorio` } }];
---
<Base titulo="Contato | Figueiredo Lima Advocacia, Brasília" descricao={`WhatsApp ${escritorio.telefone}, e-mail e atendimento presencial com horário marcado no Lago Norte, Brasília/DF. On-line em todo o Brasil.`} jsonld={jsonld}>
  <section class="noite" aria-labelledby="titulo">
    <div class="wrap topo-simples">
      <h1 class="h1" id="titulo">Fale com o escritório</h1>
      <p class="lead">Conte o seu caso pelo canal que preferir. Eu mesmo leio e respondo cada mensagem.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="canais">
        <div class="canal">
          <h2>WhatsApp e telefone</h2>
          <span class="v" id="v-tel">{escritorio.telefone}</span>
          <span class="muted small">Mensagens respondidas pelo próprio advogado</span>
          <BotaoWhatsApp rotulo="Abrir o WhatsApp" local="contato" ancora />
          <button class="copiar" type="button" data-copiar="v-tel">Copiar número</button>
        </div>
        <div class="canal">
          <h2>E-mail</h2>
          <span class="v" id="v-mail">{escritorio.email}</span>
          <span class="muted small">Para envio de documentos</span>
          <button class="copiar" type="button" data-copiar="v-mail">Copiar e-mail</button>
        </div>
        <div class="canal">
          <h2>Escritório</h2>
          <span class="v">{escritorio.bairro}, {escritorio.cidade}/{escritorio.uf}</span>
          <a class="link" href={escritorio.mapa} target="_blank" rel="noopener">Ver no Google Maps</a>
          <span class="muted small">Atendimento presencial com horário marcado; o endereço completo é enviado no agendamento.</span>
        </div>
      </div>
      <div class="texto" style="margin-top: var(--space-7);">
        <h2>Atendimento on-line</h2>
        <p>Reunião por vídeo, documentos em PDF e contrato com assinatura eletrônica, para qualquer lugar do Brasil.</p>
        <p class="small muted">Os dados enviados são protegidos pelo sigilo profissional e tratados conforme a LGPD. Veja o <a href="/privacidade/">aviso de privacidade</a>.</p>
      </div>
    </div>
  </section>
</Base>
