---
// Página Sobre: credenciais verificáveis e autoria dos artigos.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import Chamada from '../components/Chamada.astro';
import couro from '../assets/fotos/joao-couro.jpg';
import { escritorio } from '../data/escritorio';

const jsonld = [{
  '@type': 'ProfilePage',
  url: `${escritorio.site}/sobre/`,
  mainEntity: { '@id': `${escritorio.site}/#advogado` },
}];
---
<Base titulo={`${escritorio.advogado}, advogado | ${escritorio.oab}`} descricao="Advogado com atuação em direito tributário, cível e público, formado pelo IDP. Atendimento pessoal em Brasília e on-line em todo o Brasil." jsonld={jsonld}>
  <section class="noite" aria-labelledby="titulo">
    <div class="wrap topo">
      <div class="topo-grade">
        <div class="topo-texto">
          <p class="kicker">Advogado responsável, {escritorio.oab}</p>
          <h1 class="h1" id="titulo">{escritorio.advogado}</h1>
          <span class="traco" aria-hidden="true"></span>
          <p class="lead">Você fala com o advogado responsável pelo seu caso, do primeiro contato à conclusão. Eu mesmo leio e respondo cada mensagem.</p>
          <div class="acoes">
            <BotaoWhatsApp rotulo="Falar com o advogado no WhatsApp" local="sobre" grande ancora />
          </div>
        </div>
        <figure class="moldura">
          <div class="crop">
            <Picture src={couro} formats={['avif', 'webp']} widths={[480, 640, 960]} sizes="(max-width: 960px) 92vw, 420px" alt={`${escritorio.advogado} sentado em uma poltrona de couro no escritório`} loading="eager" fetchpriority="high" style="object-position: 50% 62%" />
          </div>
          <figcaption><b>{escritorio.advogado}</b><span>{escritorio.oab}</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap texto">
      <h2>Trajetória</h2>
      <p>Advogado com atuação em direito tributário, cível e público, formado pelo IDP, com estudos de pós-graduação em Direito Tributário, Direito Constitucional e Direitos Humanos pelo IDP e pela UnB.</p>
      <p>Experiência profissional em consultoria de empresas e escritórios de advocacia.</p>
      <h2>Como trabalho</h2>
      <ul class="lista lista-lg">
        <li>Atendimento pessoal, sem intermediários</li>
        <li>Riscos, prazos e honorários explicados por escrito antes de qualquer assinatura</li>
        <li>Notícia a cada andamento relevante do caso</li>
      </ul>
      <ul class="fatos" style="margin-top: var(--space-5);">
        <li><span>Inscrição</span><span><b>{escritorio.oab}</b>, <a class="link" href={escritorio.cna} target="_blank" rel="noopener">confirmar no CNA</a></span></li>
        <li><span>Escritório</span><span>{escritorio.bairro}, {escritorio.cidade}/{escritorio.uf}</span></li>
        <li><span>Atendimento</span><span>Presencial com horário marcado e on-line em todo o Brasil</span></li>
        <li><span>Sociedade</span><span>{escritorio.marca} é a marca de {escritorio.razaoSocial}, CNPJ {escritorio.cnpj}</span></li>
      </ul>
    </div>
  </section>

  <Chamada titulo="Quer conversar sobre o seu caso?" texto="Envie sua mensagem pelo WhatsApp. Eu mesmo leio e respondo." />
</Base>
