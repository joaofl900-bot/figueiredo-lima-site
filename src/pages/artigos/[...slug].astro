---
// Página de cada artigo. O texto vem de src/content/artigos/<nome>.md (escrito pelo Pages CMS).
// Topo preto com o título; o texto em bege; ao final, o bloco do autor com o convite para conversar.
import { Image } from 'astro:assets';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotaoWhatsApp from '../../components/BotaoWhatsApp.astro';
import Chamada from '../../components/Chamada.astro';
import avatar from '../../assets/fotos/joao-avatar.jpg';
import { escritorio } from '../../data/escritorio';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.draft);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props as { artigo: CollectionEntry<'artigos'> };
const { Content } = await render(artigo);
const area = await getEntry('areas', artigo.data.area);
const palavras = (artigo.body ?? '').split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.round(palavras / 200));
const data = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const url = `${escritorio.site}/artigos/${artigo.id}/`;

const jsonld = [
  {
    '@type': 'Article',
    headline: artigo.data.title,
    description: artigo.data.description,
    datePublished: artigo.data.date.toISOString(),
    dateModified: (artigo.data.updated ?? artigo.data.date).toISOString(),
    author: { '@id': `${escritorio.site}/#advogado` },
    publisher: { '@id': `${escritorio.site}/#escritorio` },
    mainEntityOfPage: url,
    inLanguage: 'pt-BR',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${escritorio.site}/` },
      { '@type': 'ListItem', position: 2, name: 'Artigos', item: `${escritorio.site}/artigos/` },
      { '@type': 'ListItem', position: 3, name: artigo.data.title, item: url },
    ],
  },
];
---
<Base titulo={`${artigo.data.title} | Figueiredo Lima`} descricao={artigo.data.description} jsonld={jsonld} tipoOg="article" mensagemWhatsApp={area?.data.mensagemWhatsApp}>
  <article>
    <header class="noite">
      <div class="wrap topo-simples">
        <nav class="trilha" aria-label="Trilha de navegação">
          <ol><li><a href="/">Início</a></li><li><a href="/artigos/">Artigos</a></li><li aria-current="page">{artigo.data.title}</li></ol>
        </nav>
        {area && <p class="kicker" style="margin-bottom: 14px;"><a class="link-noite" href={`/${area.id}/`}>{area.data.nome}</a></p>}
        <h1 class="h1" id="titulo">{artigo.data.title}</h1>
        <p class="lead">{artigo.data.description}</p>
        <p class="micro" style="margin-top: 18px;">Por <a class="link-noite" href="/sobre/">{escritorio.advogado}</a>, {escritorio.oab}. Publicado em {data(artigo.data.date)}, {minutos} min de leitura.</p>
      </div>
    </header>
    <div class="wrap sec">
      <div class="artigo">
        <Content />
        <p class="small muted" style="margin-top: var(--space-6);">Conteúdo informativo, que não substitui a análise individual de cada caso.{area && <> Saiba mais sobre <a href={`/${area.id}/`}>{area.data.nome.toLowerCase()}</a>.</>}</p>
      </div>
      <aside class="autor" aria-label="Sobre o autor">
        <Image src={avatar} alt="" width={144} height={144} loading="lazy" />
        <div>
          <h2 class="h3">Escrito por {escritorio.advogado}</h2>
          <p>Advogado, {escritorio.oab}. Se este é o seu caso, me envie uma mensagem com o que aconteceu. Eu mesmo leio e respondo.</p>
          <div class="acoes"><BotaoWhatsApp rotulo={area?.data.botao ?? 'Falar com o advogado'} mensagem={area?.data.mensagemWhatsApp} local="artigo-autor" /></div>
        </div>
      </aside>
    </div>
  </article>
  <Chamada titulo={area?.data.chamadaTitulo ?? 'Precisa de orientação jurídica?'} texto={area?.data.chamadaTexto ?? 'Envie seu caso pelo WhatsApp. Eu mesmo leio e respondo.'} mensagem={area?.data.mensagemWhatsApp} />
</Base>
