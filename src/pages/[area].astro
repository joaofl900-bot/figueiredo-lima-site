---
// Modelo das seis páginas de área (/tributario/, /planos-de-saude/...). O texto de cada uma
// fica em src/content/areas/<nome>.yaml; esta página só monta as seções na ordem aprovada:
// topo preto com a pergunta da dor, a história em quatro quadros com o fechamento, situações,
// documentos, etapas, advogado, perguntas, artigos e a chamada final.
import { Picture } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import AvisoSimples from '../components/AvisoSimples.astro';
import Historia from '../components/Historia.astro';
import Etapas from '../components/Etapas.astro';
import Advogado from '../components/Advogado.astro';
import Faq from '../components/Faq.astro';
import Chamada from '../components/Chamada.astro';
import close from '../assets/fotos/joao-close.jpg';
import principal from '../assets/fotos/joao-principal.jpg';
import couro from '../assets/fotos/joao-couro.jpg';
import punho from '../assets/fotos/joao-punho.jpg';
import { escritorio } from '../data/escritorio';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { area: area.id }, props: { area } }));
}

const { area } = Astro.props as { area: CollectionEntry<'areas'> };
const d = area.data;
const fotos = { close, principal, couro };
const posicao = { close: '50% 38%', principal: '50% 28%', couro: '50% 62%' }[d.foto];
// No fechamento, uma foto diferente da do topo: à mesa no tributário; nas demais, a outra poltrona.
const fotoFecho = d.principal ? punho : d.foto === 'principal' ? close : principal;
const comTexto = (lista: { texto?: string }[]) => lista.some((i) => i.texto);
const relacionados = (await getCollection('artigos', ({ data }) => !data.draft && data.area === area.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const url = `${escritorio.site}/${area.id}/`;
const jsonld = [
  {
    '@type': 'Service',
    '@id': `${url}#servico`,
    name: d.nome,
    serviceType: d.nome,
    url,
    description: d.seoDescricao,
    areaServed: { '@type': 'Country', name: 'Brasil' },
    provider: { '@id': `${escritorio.site}/#escritorio` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${escritorio.site}/` },
      { '@type': 'ListItem', position: 2, name: d.nome, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
  },
];
---
<Base titulo={d.seoTitulo} descricao={d.seoDescricao} jsonld={jsonld} mensagemWhatsApp={d.mensagemWhatsApp} rotuloFlutuante={d.botao} avisoRodape={d.avisoRodape}>
  {d.avisoSimples && <AvisoSimples />}

  <section class="noite" aria-labelledby="titulo">
    <div class="wrap topo">
      <nav class="trilha" aria-label="Trilha de navegação">
        <ol><li><a href="/">Início</a></li><li><a href="/#areas">Áreas</a></li><li aria-current="page">{d.nome}</li></ol>
      </nav>
      <div class="topo-grade">
        <div class="topo-texto">
          <p class="kicker">{d.sobretitulo}</p>
          <h1 class="h1" id="titulo">{d.h1}</h1>
          <span class="traco" aria-hidden="true"></span>
          <p class="lead">{d.abertura}</p>
          <div class="acoes">
            <BotaoWhatsApp rotulo={d.botao} mensagem={d.mensagemWhatsApp} local="abertura" grande ancora />
            {d.linkSecundario && <a class="link-noite" href={d.linkSecundario.href}>{d.linkSecundario.rotulo}</a>}
          </div>
          <p class="assina"><b>Eu mesmo leio e respondo cada mensagem.</b> {d.apoio}</p>
        </div>
        <figure class="moldura">
          <div class="crop">
            <Picture src={fotos[d.foto]} formats={['avif', 'webp']} widths={[480, 640, 960]} sizes="(max-width: 960px) 92vw, 420px" alt={`${escritorio.advogado}, advogado, no escritório`} loading="eager" fetchpriority="high" style={`object-position: ${posicao}`} />
          </div>
          <figcaption><b>{escritorio.advogado}</b><span>{escritorio.oab}</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Historia
    id="entenda"
    titulo={d.historiaTitulo}
    quadros={d.historia}
    frase={d.fecho.frase}
    texto={d.fecho.texto}
    itens={d.fecho.itens ?? d.frentes.map((f) => f.titulo)}
    botao={d.botao}
    mensagem={d.mensagemWhatsApp}
    link={d.destaque ? { rotulo: 'Conhecer a assessoria mensal', href: `#${d.destaque.id}` } : undefined}
    foto={fotoFecho}
    fotoAlt={`${escritorio.advogado} no escritório`}
    local="historia"
  />

  <section class="sec" aria-labelledby="t-situacoes" style="padding-top: 0;">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="t-situacoes">Situações mais comuns</h2>
        {d.situacoesIntro && <p>{d.situacoesIntro}</p>}
      </div>
      <div class="situacoes">
        {d.situacoes.map((s) => <div class="situacao"><h3 class="h3">{s.titulo}</h3>{s.texto && <p>{s.texto}</p>}</div>)}
      </div>
    </div>
  </section>

  {comTexto(d.frentes) && (
    <section class="sec" aria-labelledby="t-atuacao" style="padding-top: 0;">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="h2" id="t-atuacao">{d.frentesTitulo}</h2>
          {d.frentesIntro && <p>{d.frentesIntro}</p>}
        </div>
        <div class="frentes">{d.frentes.map((f) => <div><h3 class="h3">{f.titulo}</h3><p class="small muted">{f.texto}</p></div>)}</div>
      </div>
    </section>
  )}

  {d.destaque && (
    <section class="sec" id={d.destaque.id} aria-labelledby="t-destaque" style="padding-top: 0;">
      <div class="wrap">
        <div class="painel duas-col">
          <div style="display: flex; flex-direction: column; gap: 18px;">
            <p class="kicker">{d.destaque.sobretitulo}</p>
            <h2 class="h2" id="t-destaque">{d.destaque.titulo}</h2>
            {d.destaque.paragrafos.map((p) => <p class="muted">{p}</p>)}
            {d.destaque.nota && <p class="small muted">{d.destaque.nota}</p>}
          </div>
          <ul class="lista lista-lg" style="align-self: center;">{d.destaque.itens.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="t-docs" style="padding-top: 0;">
    <div class="wrap duas-col">
      <div class="sec-head" style="margin: 0;">
        <h2 class="h2" id="t-docs">O que separar para a primeira análise</h2>
        <p>Não precisa ter tudo. Comece com o que estiver à mão; o resto é pedido na conversa.</p>
      </div>
      <ul class="lista lista-lg" style="align-self: center;">{d.documentos.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <Etapas itens={d.etapas} titulo="Como funciona o atendimento" id="etapas" />

  <Advogado foto={d.foto === 'principal' ? 'couro' : 'principal'} id="advogado" />

  <Faq itens={d.faq} titulo={d.faqTitulo} intro="Respostas gerais. A orientação para o seu caso depende da análise dos documentos." />

  {relacionados.length > 0 && (
    <section class="sec" aria-labelledby="t-relacionados" style="padding-top: 0;">
      <div class="wrap">
        <div class="sec-head"><h2 class="h2" id="t-relacionados">Para entender melhor</h2></div>
        <div class="posts">{relacionados.map((a) => <a class="post" href={`/artigos/${a.id}/`}><h3 class="h3">{a.data.title}</h3><p>{a.data.description}</p></a>)}</div>
      </div>
    </section>
  )}

  <Chamada titulo={d.chamadaTitulo} texto={d.chamadaTexto} mensagem={d.mensagemWhatsApp} />
</Base>
