---
// Perguntas frequentes em acordeão nativo (<details>): funciona sem JavaScript e pelo teclado.
interface Props { itens: { pergunta: string; resposta: string }[]; titulo: string; intro?: string; id?: string }
const { itens, titulo, intro, id = 't-faq' } = Astro.props;
---
<section class="sec" aria-labelledby={id} style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id={id}>{titulo}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq">
      {itens.map((i) => <details><summary>{i.pergunta}</summary><p>{i.resposta}</p></details>)}
    </div>
  </div>
</section>
