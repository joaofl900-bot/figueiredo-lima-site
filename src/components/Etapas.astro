---
// Linha do tempo do atendimento, numerada porque é uma sequência de verdade.
const padrao = [
  { titulo: 'Você conta o caso', texto: 'Pelo WhatsApp, com os documentos que tiver em mãos.' },
  { titulo: 'Análise e orientação', texto: 'Explico os caminhos, os riscos e os prazos, por escrito ou por vídeo.' },
  { titulo: 'Contrato claro', texto: 'Honorários sempre em contrato escrito, assinado eletronicamente.' },
  { titulo: 'Acompanhamento', texto: 'Você recebe notícia a cada andamento relevante.' },
];
interface Props { itens?: { titulo: string; texto?: string }[]; titulo?: string; id?: string }
const { itens = padrao, titulo = 'Um caminho simples e transparente', id = 'como-funciona' } = Astro.props;
---
<section class="sec" id={id} aria-labelledby={`t-${id}`} style="padding-top: 0;">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id={`t-${id}`}>{titulo}</h2>
      <p>Você sabe o que vai acontecer em cada etapa, antes de qualquer compromisso.</p>
    </div>
    <ol class="steps" style={`--cols: ${itens.length}`}>
      {itens.map((e) => <li><strong>{e.titulo}</strong>{e.texto && <span>{e.texto}</span>}</li>)}
    </ol>
  </div>
</section>
